# =====================================================================
# STRIVE ELITE (player + coach platform)
# =====================================================================
# The app runs in DEMO MODE with rich seed data when Supabase is not
# configured, so you can deploy and tour it before wiring anything up.
# Set the vars below to switch on real auth, data, AI, and payments.

# Public — Supabase (shared by Strive Elite + Strive OS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server — Supabase service role key. Needed for invite redemption, the
# Stripe webhook, the coach bootstrap, and scripts/seed-elite.mjs. Never
# expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Server — comma-separated emails that are always coaches. The owner's
# email goes here; anyone in this list gets the coach dashboard automatically
# on login (no SQL needed). Add assistant coaches here later.
STRIVE_COACH_EMAILS=

# Server — Stripe Price IDs for the Strive Elite plans (create these in
# your Stripe dashboard). Monthly plans are subscriptions; session is one-time.
STRIVE_PRICE_MONTHLY=
STRIVE_PRICE_ELITE=
STRIVE_PRICE_SESSION=

# Public — base URL of this Strive OS deployment. Used to build Stripe
# success/cancel URLs when a request doesn't carry an Origin header
# (server-side requests, webhooks).
NEXT_PUBLIC_APP_URL=https://thestriveapp.com

# Public — external Ball Mastery course (Strive OS launches into this)
NEXT_PUBLIC_COURSE_URL=

# Server — GoHighLevel · CRM + Social Planner.
# - Dribbling course buyer is tagged with "dribbling-course-buyer" via
#   /api/ghl/dribbling-course-buyer.
# - GHL webhook lands at /api/ghl/webhook.
GHL_API_KEY=
# Strive Soccer's location. Also used directly by lib/elite/sms.ts, which
# falls back to this exact value (SjVsI2ZXLXjBrWGA0VfI) in code if unset.
GHL_LOCATION_ID=
GHL_WEBHOOK_URL=
GHL_WEBHOOK_SECRET=
# Comma-separated GHL social account IDs the planner will post to
GHL_SOCIAL_ACCOUNT_IDS=
# Two HH:mm slots (24h, location-local) for the 2x/day cadence
GHL_DAILY_SLOTS=11:00,19:00

# Server — Stripe · $97 dribbling course checkout.
# POST /api/checkout/dribbling-course creates a Checkout Session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server — Anthropic (powers the AI content engine + dribbling-course UGC)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Server — GoHighLevel EMAIL for player/parent/coach notifications. One
# GHL workflow per automation: create each with an "Inbound Webhook"
# trigger, and have that workflow send the actual email, then put its
# webhook URL in the matching per-event variable below. Events fired by
# the app that aren't covered by SMS below: player_signed_up,
# checkin_feedback, checkin_submitted, player_message, player_onboarded,
# game_submitted, film_submitted, coach_attending, film_feedback,
# coach_daily_digest. GHL_WEBHOOK_URL above is the catch-all for any event
# without its own. Optional — email no-ops until at least one of these or
# RESEND_API_KEY below is set. See lib/elite/email.ts.
GHL_WEBHOOK_URL_PLAYER_SIGNED_UP=
GHL_WEBHOOK_URL_CHECKIN_FEEDBACK=

# Player/parent SMS (new week live, coach messages, weekly parent report,
# onboarding-incomplete reminders) goes straight through the GHL API, not
# a webhook - no separate setup needed beyond GHL_API_KEY + GHL_LOCATION_ID
# above. Chosen over Twilio to skip weeks of A2P 10DLC registration since
# GHL already has a registered sending number on this location. See
# lib/elite/sms.ts.

# Inbound: a parent/player's SMS REPLY only exists in GHL until a GHL
# workflow (trigger: "Customer Replied" -> action: Webhook) relays it to
# /api/ghl/sms-inbound, which threads it into that player's existing chat
# in the app. Optional shared secret checked against a ?secret= query
# param on that webhook URL - set it here and put the same value in the
# GHL workflow's URL, or leave blank to accept unauthenticated (fine for
# initial setup, not for production). See app/api/ghl/sms-inbound/route.ts.
SMS_INBOUND_SECRET=

# Server — Resend (optional direct-email fallback if you'd rather not route
# through GoHighLevel). RESEND_FROM must be a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM=Strive Elite <coach@strivesoccer100x.com>

# Real push notifications (new week live, coach messages) straight to a
# player's phone/laptop, even with the app closed - no app store needed.
# Optional — the app works fine without these, push just no-ops. Generate a
# pair once with `npx web-push generate-vapid-keys` and never change them
# after players start subscribing (existing subscriptions break). The
# public key is intentionally NEXT_PUBLIC_ - it's meant to be visible to the
# browser, that's how it tells the push service which server can send to it.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:coach@strivesoccer100x.com

# Server — ElevenLabs (voiceovers)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Server — Fal.ai (text-to-video UGC)
# REST queue API. Auth header is `Authorization: Key <FAL_KEY>`.
# Default model is kling-video v1.6 standard text-to-video; override with
# FAL_MODEL if you prefer minimax/video-01 or another fal.ai model.
FAL_KEY=
FAL_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video

# Server — Autopilot cron (Vercel sends Authorization: Bearer <CRON_SECRET>)
# The cron runs weekly (vercel.json) and produces 14 posts = 2x/day for 7 days.
CRON_SECRET=
