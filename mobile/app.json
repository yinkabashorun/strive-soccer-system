{
  "expo": {
    "name": "Strive Elite",
    "slug": "strive-elite",
    "scheme": "striveelite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "platforms": ["ios", "web"],
    "ios": {
      "bundleIdentifier": "com.strivesoccer.elite",
      "buildNumber": "1",
      "supportsTablet": false,
      "requireFullScreen": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Strive Elite",
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"],
        "NSPhotoLibraryAddUsageDescription": "Strive Elite saves your training card and the picture of your week to your photo library when you share or save them.",
        "LSApplicationQueriesSchemes": ["instagram-stories"]
      },
      "associatedDomains": ["webcredentials:thestriveapp.com", "applinks:thestriveapp.com"],
      "entitlements": { "aps-environment": "production" },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] }
        ]
      }
    },
    "web": { "favicon": "./assets/favicon.png", "bundler": "metro", "output": "single" },
    "plugins": [
      "expo-router",
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4" } }],
      [
        "expo-splash-screen",
        { "backgroundColor": "#000000", "image": "./assets/splash.png", "imageWidth": 140 }
      ],
      [
        "expo-font",
        { "fonts": ["./assets/fonts/Oswald-Bold.ttf", "./assets/fonts/Inter-Medium.ttf", "./assets/fonts/Inter-SemiBold.ttf"] }
      ],
      ["expo-notifications", { "mode": "production", "enableBackgroundRemoteNotifications": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Strive Elite opens your photo library so you can choose your profile photo.",
          "cameraPermission": "Strive Elite uses the camera for your start photo and your finish photo when you train, and for your profile photo.",
          "microphonePermission": "Strive Elite uses the microphone to record sound with the clips you film."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Strive Elite uses the microphone to record sound with the clips you film.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      ["expo-video", { "supportsBackgroundPlayback": false, "supportsPictureInPicture": false }],
      [
        "expo-media-library",
        {
          "photosPermission": "Strive Elite opens your photo library so you can choose your profile photo.",
          "savePhotosPermission": "Strive Elite saves your training card and the picture of your week to your photo library when you share or save them.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": { "tsconfigPaths": true },
    "extra": {
      "apiBase": "https://thestriveapp.com",
      "supabaseUrl": "https://qjiloadpfeqxxyfozsje.supabase.co",
      "supabaseKey": "sb_publishable_ulSP6W3OQuJsl5ohSG1_UA_TQHJI7eY"
    }
  }
}
