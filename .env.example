# =====================================================================
# STRIVE ELITE (player + coach platform)
# =====================================================================
# The app runs in DEMO MODE with rich seed data when Supabase is not
# configured, so you can deploy and tour it before wiring anything up.
# Set the vars below to switch on real auth, data, AI, and payments.

# Public — Supabase (shared by Strive Elite + Strive OS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server — Supabase service role key. Needed for invite redemption, the
# Stripe webhook, the coach bootstrap, and scripts/seed-elite.mjs. Never
# expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Server — comma-separated emails that are always coaches. The owner's
# email goes here; anyone in this list gets the coach dashboard automatically
# on login (no SQL needed). Add assistant coaches here later.
STRIVE_COACH_EMAILS=

# Server — Stripe Price IDs for the Strive Elite plans (create these in
# your Stripe dashboard). Monthly plans are subscriptions; session is one-time.
STRIVE_PRICE_MONTHLY=
STRIVE_PRICE_ELITE=
STRIVE_PRICE_SESSION=

# Public — base URL of this Strive OS deployment. Used to build Stripe
# success/cancel URLs when a request doesn't carry an Origin header
# (server-side requests, webhooks).
NEXT_PUBLIC_APP_URL=https://thestriveapp.com

# Public — external Ball Mastery course (Strive OS launches into this)
NEXT_PUBLIC_COURSE_URL=

# Server — GoHighLevel · CRM + Social Planner.
# - Dribbling course buyer is tagged with "dribbling-course-buyer" via
#   /api/ghl/dribbling-course-buyer.
# - GHL webhook lands at /api/ghl/webhook.
GHL_API_KEY=
GHL_LOCATION_ID=
GHL_WEBHOOK_URL=
GHL_WEBHOOK_SECRET=
# Comma-separated GHL social account IDs the planner will post to
GHL_SOCIAL_ACCOUNT_IDS=
# Two HH:mm slots (24h, location-local) for the 2x/day cadence
GHL_DAILY_SLOTS=11:00,19:00

# Server — Stripe · $97 dribbling course checkout.
# POST /api/checkout/dribbling-course creates a Checkout Session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Server — Anthropic (powers the AI content engine + dribbling-course UGC)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Server — GoHighLevel (primary channel for player/parent email + SMS).
# One GHL workflow per automation: create each with an "Inbound Webhook"
# trigger and put its URL in the matching per-event variable. Events:
# player_signed_up, new_week, coach_message, checkin_feedback,
# checkin_submitted, player_message, player_onboarded.
# GHL_WEBHOOK_URL is an optional catch-all for any event without its own.
# Optional — notifications no-op until at least one is set.
GHL_WEBHOOK_URL=
GHL_WEBHOOK_URL_PLAYER_SIGNED_UP=
GHL_WEBHOOK_URL_NEW_WEEK=
GHL_WEBHOOK_URL_COACH_MESSAGE=
GHL_WEBHOOK_URL_CHECKIN_FEEDBACK=
GHL_WEBHOOK_URL_PARENT_WEEKLY_REPORT=

# Server — Resend (optional direct-email fallback if you'd rather not route
# through GoHighLevel). RESEND_FROM must be a verified sender/domain.
RESEND_API_KEY=
RESEND_FROM=Strive Elite <coach@strivesoccer100x.com>

# Server — ElevenLabs (voiceovers)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Server — Fal.ai (text-to-video UGC)
# REST queue API. Auth header is `Authorization: Key <FAL_KEY>`.
# Default model is kling-video v1.6 standard text-to-video; override with
# FAL_MODEL if you prefer minimax/video-01 or another fal.ai model.
FAL_KEY=
FAL_MODEL=fal-ai/kling-video/v1.6/standard/text-to-video

# Server — Autopilot cron (Vercel sends Authorization: Bearer <CRON_SECRET>)
# The cron runs weekly (vercel.json) and produces 14 posts = 2x/day for 7 days.
CRON_SECRET=
